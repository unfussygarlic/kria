# Kria Frontend - Production Dockerfile
# Builds Expo app for production deployment

FROM node:20-slim AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Expo and EAS CLI
RUN npm install -g expo-cli@latest eas-cli@latest

# Copy package files
COPY package*.json ./

# Install production dependencies
RUN npm ci --production=false

# Copy source code
COPY . .

# Build arguments for environment
ARG EXPO_PUBLIC_APP_ENV=production
ARG EXPO_PUBLIC_SUPABASE_URL
ARG EXPO_PUBLIC_SUPABASE_ANON_KEY

# Set environment variables
ENV EXPO_PUBLIC_APP_ENV=$EXPO_PUBLIC_APP_ENV
ENV EXPO_PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL
ENV EXPO_PUBLIC_SUPABASE_ANON_KEY=$EXPO_PUBLIC_SUPABASE_ANON_KEY
ENV NODE_ENV=production

# Run TypeScript check
RUN npx tsc --noEmit || true

# Export static web build (optional - for web preview)
RUN npx expo export --platform web --output-dir dist || true

# ===========================================
# Production Stage
# ===========================================
FROM node:20-slim AS production

WORKDIR /app

# Copy built assets
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/app.json ./
COPY --from=builder /app/eas.json ./

# Install serve for static hosting (web preview only)
RUN npm install -g serve

# Expose port for web preview
EXPOSE 3000

# Note: For actual mobile app deployment, use EAS Build:
# eas build --platform all --profile production
# eas submit --platform all

# Serve web build (for preview purposes)
CMD ["serve", "-s", "dist", "-l", "3000"]
