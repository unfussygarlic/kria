# Copy to .env and adjust values

# Model size: "buffalo_sc" (fast, CPU-friendly) or "buffalo_l" (accurate, needs more RAM)
INSIGHTFACE_MODEL=buffalo_sc

# Cosine similarity threshold [0, 1] — raise to reduce false positives
MATCH_THRESHOLD=0.35

# Minimum face size to accept (pixels)
MIN_FACE_SIZE_PX=50

# Downscale images with long side > this (0 = disabled)
MAX_IMAGE_LONG_SIDE=1920

# Liveness: how many blinks required
LIVENESS_MIN_BLINKS=1

# Liveness: minimum cumulative head yaw change
LIVENESS_MIN_HEAD_MOVEMENT=5.0

# EAR blink threshold (lower = more sensitive)
EAR_BLINK_THRESHOLD=0.20

# Temp directory for uploaded video files
UPLOAD_DIR=/tmp/inspector_uploads
