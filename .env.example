# Kria Environment Variables Template
# Copy to .env.development or .env.production and fill in values

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================

# For local development (docker-compose)
SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321

# JWT Secret (min 32 characters) - generate with: openssl rand -base64 32
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters

# Anon Key (dev local stack) - generate at https://supabase.com/docs/guides/self-hosting#api-keys
# In production this is the publishable key (sb_publishable_...) from Supabase → Settings → API Keys
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Service Role Key (NEVER expose to frontend) — dev local stack value below
# In production this is the secret key (sb_secret_...) from Supabase → Settings → API Keys
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Secret Key Base (for Realtime) - generate with: openssl rand -base64 64
SECRET_KEY_BASE=super-secret-key-base-at-least-64-characters-long-for-realtime-service-generate-new-one

# ===========================================
# DATABASE
# ===========================================

POSTGRES_PASSWORD=postgres

# ===========================================
# SMS / OTP (Fast2SMS via GoTrue SMS hook)
# ===========================================

# Set to 'true' for development (auto-confirms OTPs without sending SMS).
# Set to 'false' in production so GoTrue calls the SMS hook below.
SMS_AUTOCONFIRM=true

# --- Production only ---
# Enable the GoTrue SMS hook (set to 'true' when SMS_AUTOCONFIRM=false)
GOTRUE_HOOK_SEND_SMS_ENABLED=false

# Shared HMAC secret — GoTrue signs each hook request with this.
# Generate with: openssl rand -base64 32
# Prefix the base64 value with "v1,whsec_" e.g. v1,whsec_abc123...
# Set the SAME value in GOTRUE_HOOK_SEND_SMS_SECRETS and GOTRUE_HOOK_SECRET.
GOTRUE_HOOK_SECRET=

# Fast2SMS credentials — get from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=
# From your DLT-approved OTP template in the Fast2SMS dashboard:
FAST2SMS_SENDER_ID=     # e.g. WAGIFY
FAST2SMS_MESSAGE_ID=    # 6-digit Message ID

# ===========================================
# APP CONFIGURATION
# ===========================================

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Your machine's IP (for Expo on physical devices)
HOST_IP=

# Allowed redirect URLs (comma-separated)
SITE_URL=http://localhost:8081
ADDITIONAL_REDIRECT_URLS=

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Sentry (error tracking)
EXPO_PUBLIC_SENTRY_DSN=

# Analytics
EXPO_PUBLIC_ANALYTICS_KEY=

# ===========================================
# GOOGLE MAPS
# Used server-side only (FastAPI geocoding). NEVER put the real key in .env.development.
# Set via shell: export GOOGLE_MAPS_API_KEY=AIza...
# ===========================================
GOOGLE_MAPS_API_KEY=

# ===========================================
# PRODUCTION (.env.prod on EC2 server)
# Copy this block, save as .env.prod on the server, fill in real values.
# See infra/DEPLOY.md for where to find each value.
# Run: bash infra/deploy.sh
# ===========================================

# Supabase Cloud project URL — Settings → API → Project URL
# SUPABASE_URL=https://<ref>.supabase.co

# Secret key — Settings → API Keys → Secret key (sb_secret_...)
# NEVER commit this value. NEVER use the publishable key here.
# SUPABASE_SERVICE_KEY=sb_secret_...

# JWT secret — Settings → API → JWT Settings → JWT Secret
# SUPABASE_JWT_SECRET=...

# DB connection (click Connect button in Supabase dashboard → Session mode tab — IPv4, required for EC2)
# Change scheme from postgresql:// to postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Google Maps API key (server-side geocoding only)
# GOOGLE_MAPS_API_KEY=AIza...

# Inspector antispoof — keep False until validated with real selfies
# ANTISPOOF_MODEL_ENABLED=False

# Must be set to production to lock CORS to trykria.com origins
# ENVIRONMENT=production

# SMS / OTP (production)
# SMS_AUTOCONFIRM=false
# GOTRUE_HOOK_SEND_SMS_ENABLED=true
# GOTRUE_HOOK_SECRET=v1,whsec_<base64>    # generate: openssl rand -base64 32, then prefix
# FAST2SMS_API_KEY=<from fast2sms.com/dashboard/dev-api>
# FAST2SMS_SENDER_ID=<DLT Sender ID, e.g. WAGIFY>
# FAST2SMS_MESSAGE_ID=<6-digit Message ID from your DLT-approved OTP template>
